  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5a9ebd953a130654a915627be5fe9f97, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CupPrototype.UI.RecipeTerminalPrototype
  bridge: {fileID: 479408778}
  font: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  displayCanvas: {fileID: 1562176021}
  workRoot: {fileID: 1993514358}
  browserRoot: {fileID: 1493851120}
  workTitle: {fileID: 1687715798}
  workIngredients: {fileID: 1866890265}
  workMethod: {fileID: 911798971}
  workStatus: {fileID: 1386745353}
  recipes:
  - name: Midnight Bloom
    ingredients: 'Vodka | 30 ml

      Cassis | 15 ml

      Lemon | 20 ml

      Syrup
      | 10 ml'
    method: Shake
    glass: Coupe
    garnish: Lemon peel
    taste: Sour
    style: Fruity
    description: Dark fruit, bright citrus, a clean finish.
    notes: '1  Add ingredients and ice to shaker.

      2  Shake until cold.

      3 
      Strain into a chilled coupe; finish with peel.'
    values: 480000003a0000001600000042000000300000004c000000
  - name: Amber Circuit
    ingredients: 'Whiskey | 40 ml

      Sweet vermouth | 20 ml

      Bitters |
      2 ml'
    method: Stir
    glass: Rocks
    garnish: Orange peel
    taste: Bitter
    style: Spirit
    description: Warm spice and a dry, aromatic finish.
    notes: '1  Stir ingredients over ice.

      2  Strain over a large cube.

      3 
      Express orange peel over the glass.'
    values: 0f000000280000004600000014000000520000004b000000
  - name: Neon Spritz
    ingredients: 'Gin | 30 ml

      Citrus cordial | 20 ml

      Soda | 60 ml'
    method: Build
    glass: Highball
    garnish: Lime wheel
    taste: Fresh
    style: Citrus
    description: Light, sparkling citrus with a botanical edge.
    notes: '1  Fill highball with ice.

      2  Add gin and cordial; top with soda.

      3 
      Stir gently and garnish.'
    values: 3700000023000000140000005a000000190000003c000000
  - name: Velvet District
    ingredients: 'Rum | 35 ml

      Vanilla syrup | 15 ml

      Cream | 25 ml'
    method: Shake
    glass: Coupe
    garnish: Nutmeg
    taste: Sweet
    style: Fruity
    description: Soft vanilla and a rich, rounded texture.
    notes: '1  Add ingredients and ice to shaker.

      2  Shake briefly.

      3 
      Fine strain; finish with nutmeg.'
    values: 0a000000550000000c000000120000005800000041000000
  - name: Citrus Signal
    ingredients: 'Tequila | 35 ml

      Lemon | 20 ml

      Syrup | 15 ml'
    method: Shake
    glass: Rocks
    garnish: Lemon wheel
    taste: Sour
    style: Citrus
    description: A crisp, bright sour with a lively finish.
    notes: '1  Shake all ingredients with ice.

      2  Strain over fresh ice.

      3 
      Garnish with a lemon wheel.'
    values: 550000003200000012000000480000002d0000003a000000
